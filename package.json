{
  "name": "web3-signals-agent",
  "version": "0.1.0",
  "description": "Personal AI agent that watches on-chain, social, and news sources for web3 market signals and ranks opportunities.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "run:once": "tsx src/index.ts --once",
    "bot": "tsx src/botServer.ts",
    "research": "tsx src/researchCli.ts",
    "research:server": "tsx src/researchServer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
